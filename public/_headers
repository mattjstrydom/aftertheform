# Cloudflare Workers static assets only (the Worker does not run for these files, so next.config.ts headers don't apply).
# Other hosts ignore this file. Pages and the API get the full header set from next.config.ts.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/_img/*
  Cache-Control: public,max-age=86400

/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
