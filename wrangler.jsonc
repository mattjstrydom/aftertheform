// Cloudflare Workers config for the OpenNext adapter (@opennextjs/cloudflare). Nothing here creates account resources:
// no R2, KV, D1, Durable Objects or Images binding is used, because every page is static and images are pre-sized.
// Runtime secret: SEQUENZY_API_KEY (set it with `npx wrangler secret put SEQUENZY_API_KEY` or in the dashboard, never here).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aftertheform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Node.js APIs for the Next.js server code
    "nodejs_compat",
    // fetch() in the Worker can only reach public addresses (the form API calls api.sequenzy.com)
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
